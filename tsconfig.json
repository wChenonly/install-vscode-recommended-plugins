{
  "compilerOptions": {
    "sourceMap": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "jsx": "preserve",
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strictFunctionTypes": true,
    "isolatedDeclarations": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  }
}
