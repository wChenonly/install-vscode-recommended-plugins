{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 160,
  "proseWrap": "never",
  "arrowParens": "avoid",
  "ignorePatterns": ["**/__snapshots__"],
  "experimentalSortImports": {
    "ignoreCase": true,
    "newlinesBetween": false
  }
}
